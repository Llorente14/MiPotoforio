---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import SakuraParticles from '../components/SakuraParticles';
import SkyBackground from '../components/SkyBackground.astro';

interface Props {
  title: string;
  description: string;
  // Absolute path of a share image under /public. Defaults to the Night-sky card.
  image?: string;
  ogType?: 'website' | 'article';
}

const { title, description, image = '/og.png', ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---

<html lang="en" data-sky="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content="Axel Chrisdy Sanjaya" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Axel Chrisdy Sanjaya's portfolio card: his name beside Kaito Kid's calling card" />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="author" content="Axel Chrisdy Sanjaya" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <!-- Browser chrome follows the Sky Theme; the script below swaps it when the saved theme is Night. -->
    <meta name="theme-color" content="#ece4d0" />
    <script is:inline>
      // Apply the saved Sky Theme before first paint (no flash). Storage may throw.
      try {
        var sky = localStorage.getItem('sky-theme');
        document.documentElement.dataset.sky = sky === 'night' ? 'night' : 'day';
        if (sky === 'night') document.querySelector('meta[name="theme-color"]').content = '#121a2e';
      } catch (e) {
        document.documentElement.dataset.sky = 'day';
      }
    </script>
    <title>{title}</title>
  </head>
  <body class="text-ink outline-none" tabindex="-1">
    <SkyBackground />
    <SakuraParticles client:idle />
    <Navbar />
    <a
      href="#main"
      class="label absolute left-3 top-3 z-50 -translate-y-24 bg-ink px-4 py-3 text-paper focus:translate-y-0"
    >
      Skip to content
    </a>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <ScrollToTop />
  </body>
</html>
