---
import { getEntry } from 'astro:content';
import ModelSlot from './ModelSlot';
import SectionHead from './SectionHead.astro';

const entry = await getEntry('profile', 'profile');
if (!entry) throw new Error('Profile content entry "profile" is missing');
const { name, university, major, semester, totalSemesters, gpa, gpaScale } = entry.data;
const pad = (n: number) => String(n).padStart(2, '0');
---

<!-- The page the Hero card opens into: a calling card with a double frame and Kid's mark in the corner. -->
<section id="about" aria-labelledby="about-heading" class="relative px-3 pt-3 md:px-5 md:pt-5">
  <div class="card-face relative mx-auto max-w-[90rem] bg-paper px-5 pb-12 pt-20 md:px-12 md:py-14">
    <img class="card-face__mark" src="/brand/kaito-mark.webp" alt="" width="192" height="192" aria-hidden="true" />

    <div class="grid items-center gap-10 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-6 md:pl-6">
        <SectionHead number="02" kanji="私" label="Who" id="about-heading" title="About me" />

        <dl class="mt-10 border-t border-rule">
          <div class="record-row"><dt class="label">Name</dt><dd>{name}</dd></div>
          <div class="record-row"><dt class="label">University</dt><dd>{university}</dd></div>
          <div class="record-row">
            <dt class="label">Programme</dt>
            <dd>{major}, <span class="semester-pill">semester {semester}</span></dd>
          </div>
        </dl>

        <!-- Two stat stamps: how far along the degree is (one tick per semester) and the GPA on its scale. -->
        <div class="mt-10 grid gap-4 sm:grid-cols-2">
          <div class="stat">
            <p class="label">Semester <span class="font-jp tracking-normal opacity-75" lang="ja">学期</span></p>
            <p class="stat__value display" aria-hidden="true">
              {pad(semester)}<span class="stat__of">/{pad(totalSemesters)}</span>
            </p>
            <ol class="semester__ticks" aria-label={`Semester ${semester} of ${totalSemesters}`}>
              {
                Array.from({ length: totalSemesters }, (_, i) => (
                  <li
                    class:list={['semester__tick', i < semester - 1 && 'is-done', i === semester - 1 && 'is-now']}
                    aria-current={i === semester - 1 ? 'step' : undefined}
                  >
                    <span class="sr-only">Semester {i + 1}</span>
                  </li>
                ))
              }
            </ol>
          </div>
          <div class="stat">
            <p class="label">GPA <span class="font-jp tracking-normal opacity-75" lang="ja">成績</span></p>
            <p class="stat__value display">
              {gpa.toFixed(2)}<span class="stat__of">/{gpaScale.toFixed(2)}</span>
            </p>
            <div class="gpa__track" role="meter" aria-label="GPA" aria-valuemin={0} aria-valuemax={gpaScale} aria-valuenow={gpa}>
              <span class="gpa__fill" style={`width: ${(gpa / gpaScale) * 100}%`}></span>
            </div>
          </div>
        </div>
      </div>

      <figure class="relative md:col-span-6">
        <p class="tategaki stage__kanji" aria-hidden="true">大学二号館</p>
        <ModelSlot client:visible id="untar" aspect="1 / 1" alt="Cel-shaded 3D model of UNTAR Building 2" />
        <figcaption class="label mt-4 flex justify-between px-2 opacity-80">
          <span>Campus I · Building 2</span><span>Jakarta Barat</span>
        </figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .card-face {
    border-radius: 0.75rem;
    box-shadow:
      inset 0 0 0 2px var(--color-ink),
      inset 0 0 0 9px var(--color-paper),
      inset 0 0 0 10px var(--color-ink);
  }
  /* Kid's doodle stamped in the corner: this page is the calling card the Hero threw. */
  .card-face__mark {
    position: absolute;
    top: 1.6rem;
    left: 1.7rem;
    width: 3.6rem;
    height: auto;
  }
  /* the mark is black ink: on the Night card print it in washi instead */
  :global([data-sky='night']) .card-face__mark {
    filter: invert(1);
  }
  .record-row {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--color-rule);
    font-size: 1.125rem;
  }
  @media (min-width: 768px) {
    .record-row {
      grid-template-columns: 8rem 1fr;
    }
  }
  .record-row dt {
    opacity: 0.8;
  }
  /* The current semester as a small shu stamp, set in the label voice so it stays tidy in the row. */
  .semester-pill {
    display: inline-block;
    padding: 0.15em 0.65em 0.2em;
    border-radius: 999px;
    background: var(--color-torii);
    color: var(--color-paper);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.8em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    vertical-align: 0.1em;
  }

  /* stat stamps: label, a big shu figure over its scale, then a meter */
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 1.3rem 1.3rem;
    border: 1px solid var(--color-ink);
    border-radius: 0.6rem;
  }
  .stat__value {
    font-size: clamp(3.25rem, 5vw, 4.5rem);
    color: var(--color-torii);
  }
  .stat__of {
    font-size: 0.4em;
    color: var(--color-ink);
    opacity: 0.7;
  }
  .gpa__track {
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-rule);
    overflow: hidden;
  }
  .gpa__fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: linear-gradient(to right, var(--color-ink) 85%, var(--color-torii));
  }
  .semester__ticks {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: 0.35rem;
  }
  .semester__tick {
    height: 0.55rem;
    border-radius: 999px;
    background: var(--color-rule);
  }
  .semester__tick.is-done {
    background: var(--color-ink);
  }
  .semester__tick.is-now {
    background: var(--color-torii);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--color-torii) 25%, transparent);
  }

  .stage__kanji {
    position: absolute;
    top: 0.5rem;
    left: 0;
    z-index: 1;
    font-size: 1.5rem;
    letter-spacing: 0.3em;
    opacity: 0.75;
  }
</style>
