---
import { getCollection } from 'astro:content';
import ProjectCard from './ProjectCard.astro';

const featured = (await getCollection('projects'))
  .sort((a, b) => a.data.featuredOrder - b.data.featuredOrder)
  .slice(0, 3);

const fmt = new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const certificates = (await getCollection('certificates'))
  .sort((a, b) => a.data.featuredOrder - b.data.featuredOrder)
  .slice(0, 3);
---

<section id="portfolio" aria-labelledby="portfolio-heading" class="mx-auto max-w-5xl px-4 py-16">
  <h2 id="portfolio-heading" class="font-display text-3xl">Portfolio</h2>
  <ul aria-label="Featured projects" class="mt-6 grid gap-6 md:grid-cols-3">
    {featured.map((project) => <ProjectCard project={project} />)}
  </ul>
  <p class="mt-6"><a class="underline" href="/projects/">View all projects</a></p>

  <h3 class="mt-12 font-display text-2xl">Certificates</h3>
  <ul aria-label="Featured certificates" class="mt-6 grid gap-6 md:grid-cols-3">
    {
      certificates.map((c) => (
        <li class="overflow-hidden rounded-lg bg-paper/80 shadow backdrop-blur">
          <a href="/certificates/" class="block h-full">
            <img src={c.data.image} alt={c.data.imageAlt} width="1200" height="850" loading="lazy" class="aspect-[1200/850] w-full object-cover" />
            <span class="block p-4">
              <span class="block font-display text-lg">{c.data.title}</span>
              <span class="mt-1 block text-sm">{c.data.issuer} · {fmt.format(c.data.date)}</span>
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  <p class="mt-6 flex flex-wrap items-center gap-6">
    <a class="underline" href="/certificates/">View all certificates</a>
    <a
      class="rounded bg-torii px-4 py-1 text-paper"
      href="/Axel-Chrisdy-Sanjaya-CV.pdf"
      download="Axel-Chrisdy-Sanjaya-CV.pdf"
    >
      Download CV
    </a>
  </p>
</section>
