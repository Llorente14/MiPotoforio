---
// Section heading in the print grammar: "02 / 私 — WHO", then the condensed title.
interface Props {
  number: string;
  kanji: string;
  label: string;
  id: string;
  title: string;
}

const { number, kanji, label, id, title } = Astro.props;
---

<header>
  <p class="label flex items-center gap-3 opacity-75">
    <span>{number}</span>
    <span aria-hidden="true" class="font-jp text-base tracking-normal text-torii" lang="ja">{kanji}</span>
    <span aria-hidden="true" class="h-px w-10 bg-current opacity-50"></span>
    <span>{label}</span>
  </p>
  <h2 id={id} class="display mt-4 text-[length:var(--text-3xl)]">{title}</h2>
</header>
