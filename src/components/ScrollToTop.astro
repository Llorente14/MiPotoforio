<button
  type="button"
  id="scroll-to-top"
  hidden
  aria-label="Scroll to top"
  class="label fixed bottom-4 right-4 z-40 flex flex-col items-center justify-center gap-0.5 bg-ink px-3 py-2.5 text-paper transition-transform hover:-translate-y-0.5 md:bottom-6 md:right-6"
>
  <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
    <path d="M12 19V5M5 12l7-7 7 7" />
  </svg>
  <span aria-hidden="true">Top</span>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('#scroll-to-top')!;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  function sync() {
    button.hidden = window.scrollY <= window.innerHeight;
  }

  button.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduced.matches ? 'instant' : 'smooth' });
    // Keyboard users continue from the top of the document, not from the now-offscreen button.
    document.body.focus({ preventScroll: true });
  });

  window.addEventListener('scroll', sync, { passive: true });
  sync();
</script>
