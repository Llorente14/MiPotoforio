---
import { getEntry } from 'astro:content';

const entry = await getEntry('profile', 'profile');
if (!entry) throw new Error('Profile content entry "profile" is missing');
const { name, socials } = entry.data;
const year = new Date().getFullYear();
---

<footer class="relative mt-24 overflow-hidden pt-32">
  <!-- Stable hook for the sakura particles to land on the meadow's top edge. -->
  <div id="meadow-top" data-meadow-top aria-hidden="true" class="absolute inset-x-0 top-[7.5rem] h-0"></div>

  <svg
    aria-hidden="true"
    viewBox="0 0 1200 220"
    preserveAspectRatio="none"
    class="pointer-events-none absolute inset-x-0 top-0 h-56 w-full"
  >
    <g data-parallax="0.15" fill="#7cb342" opacity="0.55">
      <path d="M0 120 Q150 60 300 110 T600 100 T900 110 T1200 90 V260 H0Z" />
    </g>
    <g data-parallax="0.3" fill="#558b2f" opacity="0.8">
      <path d="M0 150 Q200 100 400 140 T800 130 T1200 140 V260 H0Z" />
    </g>
    <g data-parallax="0.5" fill="#33691e">
      <path d="M0 180 Q250 140 500 175 T1000 165 T1200 175 V260 H0Z" />
    </g>
    <!-- Sakura tree silhouette -->
    <g fill="#5d4037" transform="translate(940 20)">
      <path d="M44 150 L48 90 Q40 70 20 55 L28 50 Q44 62 50 76 Q54 56 70 40 L76 46 Q60 62 56 90 L60 150Z" />
    </g>
    <g fill="#f4b6c2" opacity="0.9" transform="translate(940 20)">
      <circle cx="20" cy="48" r="22" />
      <circle cx="52" cy="30" r="28" />
      <circle cx="84" cy="44" r="22" />
      <circle cx="40" cy="64" r="18" />
      <circle cx="72" cy="66" r="18" />
    </g>
  </svg>

  <div class="relative mx-auto flex max-w-5xl flex-col items-center gap-4 bg-[#33691e] px-4 py-10 text-center text-white">
    <ul class="flex flex-wrap justify-center gap-6">
      <li><a class="underline" href={socials.github}>GitHub</a></li>
      <li><a class="underline" href={socials.linkedin}>LinkedIn</a></li>
      <li><a class="underline" href={`mailto:${socials.email}`}>Email</a></li>
    </ul>
    <p>© {year} {name}</p>
  </div>
</footer>

<script>
  const layers = document.querySelectorAll<SVGGElement>('[data-parallax]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  let ticking = false;

  function update() {
    ticking = false;
    const footer = document.querySelector('footer');
    if (!footer) return;
    const progress = Math.min(Math.max(1 - footer.getBoundingClientRect().top / window.innerHeight, 0), 1);
    layers.forEach((layer) => {
      const speed = Number(layer.dataset.parallax);
      layer.style.transform = `translateY(${(progress * speed * 24).toFixed(1)}px)`;
    });
  }

  function onScroll() {
    if (reduced.matches || ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  reduced.addEventListener('change', () => {
    if (reduced.matches) layers.forEach((l) => (l.style.transform = ''));
    else update();
  });
</script>
