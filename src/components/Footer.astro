---
import { getEntry } from 'astro:content';
import SocialIcon from './SocialIcon.astro';

const entry = await getEntry('profile', 'profile');
if (!entry) throw new Error('Profile content entry "profile" is missing');
const { name, socials } = entry.data;
const year = new Date().getFullYear();

// Ink grass, two rows: a soft back row and a sharp front row. Deterministic so every build matches.
const row = (count: number, base: number, min: number, spread: number, seed: number) =>
  Array.from({ length: count }, (_, i) => {
    const x = (i / count) * 1200 + ((i * seed) % 9) - 4;
    const h = min + ((i * (seed + 16)) % spread) + (i % 11 === 0 ? spread * 0.7 : 0);
    const lean = ((i * (seed + 4)) % 15) - 7;
    return `M${(x - 5).toFixed(1)} ${base} Q${(x + lean * 0.3).toFixed(1)} ${base - h * 0.55} ${(x + lean).toFixed(1)} ${base - h} Q${(x + lean * 0.15 + 2).toFixed(1)} ${base - h * 0.45} ${(x + 6).toFixed(1)} ${base}Z`;
  }).join('');
const back = row(110, 200, 40, 50, 23);
const front = row(170, 200, 22, 44, 37);
---

<footer class="relative mt-16 overflow-hidden pt-72">
  <!-- Stable hook for the sakura particles to land on the meadow's top edge. -->
  <div id="meadow-top" data-meadow-top aria-hidden="true" class="absolute inset-x-0 top-[12.5rem] h-0"></div>

  <!-- A sakura tree in ink on the meadow: its petals are the ones drifting down the page. -->
  <svg aria-hidden="true" viewBox="0 0 420 300" class="footer__tree">
    <g fill="#17140f">
      <path d="M196 300 C200 250 192 214 172 180 C150 146 112 128 70 120 L74 110 C116 116 150 130 176 158 C178 128 168 100 146 74 L156 68 C182 98 192 130 188 166 C200 140 226 116 262 104 L266 114 C232 128 210 150 200 182 C214 214 218 256 214 300 Z" />
      <path d="M262 104 C292 92 322 92 350 100 L348 108 C322 102 294 104 268 114 Z M146 74 C138 58 124 44 104 34 L110 26 C132 38 148 54 156 68 Z" />
    </g>
    <g fill="var(--color-sakura)">
      <circle cx="70" cy="108" r="38" /><circle cx="110" cy="86" r="34" /><circle cx="104" cy="34" r="30" />
      <circle cx="146" cy="56" r="40" /><circle cx="196" cy="72" r="44" /><circle cx="244" cy="62" r="40" />
      <circle cx="268" cy="104" r="40" /><circle cx="318" cy="88" r="36" /><circle cx="352" cy="104" r="30" />
      <circle cx="160" cy="120" r="30" /><circle cx="222" cy="118" r="28" />
    </g>
    <g fill="color-mix(in srgb, var(--color-sakura) 60%, #fff)">
      <circle cx="120" cy="70" r="16" /><circle cx="200" cy="52" r="18" /><circle cx="262" cy="84" r="14" /><circle cx="84" cy="96" r="12" />
    </g>
  </svg>
  <svg aria-hidden="true" viewBox="0 0 1200 200" preserveAspectRatio="none" class="pointer-events-none absolute inset-x-0 top-[8rem] h-40 w-full">
    <g data-parallax="0.25" fill="#17140f" opacity="0.45"><path d={back} /></g>
    <g data-parallax="0.5" fill="#0d0b08"><path d={front} /><rect y="196" width="1200" height="4" /></g>
  </svg>

  <div class="relative bg-[#0d0b08] text-[#ece4d0]">
    <div class="mx-auto grid max-w-[90rem] gap-10 px-4 pb-10 pt-6 md:grid-cols-12 md:px-8">
      <p class="font-jp text-[clamp(4rem,12vw,10rem)] leading-none md:col-span-7" lang="ja" aria-hidden="true">またね</p>
      <div class="flex flex-col justify-end gap-6 md:col-span-5">
        <p class="label opacity-75">Until the next card</p>
        <ul class="flex flex-wrap gap-x-8 gap-y-3">
          <li><a class="label label-link inline-flex items-center gap-2" href={socials.github}><SocialIcon name="github" class="size-4" />GitHub</a></li>
          <li><a class="label label-link inline-flex items-center gap-2" href={socials.linkedin}><SocialIcon name="linkedin" class="size-4" />LinkedIn</a></li>
          <li><a class="label label-link inline-flex items-center gap-2" href={`mailto:${socials.email}`}><SocialIcon name="email" class="size-4" />Email</a></li>
        </ul>
      </div>
    </div>
    <div class="mx-auto flex max-w-[90rem] flex-wrap justify-between gap-3 border-t border-[#ece4d0]/15 px-4 py-5 md:px-8">
      <p class="label opacity-80">© {year} {name}</p>
      <p class="label opacity-75">Printed in Jakarta · 6°10′S 106°47′E</p>
    </div>
  </div>
</footer>

<style>
  .footer__tree {
    position: absolute;
    right: max(4vw, 1rem);
    /* trunk planted in the grass, just above the ink band */
    top: calc(18.4rem - min(26rem, 60vw) * 0.714);
    width: min(26rem, 60vw);
    pointer-events: none;
  }
  footer .label-link {
    text-decoration-color: rgb(236 228 208 / 0.35);
  }
  footer .label-link:hover {
    text-decoration-color: currentColor;
  }
</style>

<script>
  const layers = document.querySelectorAll<SVGGElement>('[data-parallax]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  let ticking = false;

  function update() {
    ticking = false;
    const footer = document.querySelector('footer');
    if (!footer) return;
    const progress = Math.min(Math.max(1 - footer.getBoundingClientRect().top / window.innerHeight, 0), 1);
    layers.forEach((layer) => {
      const speed = Number(layer.dataset.parallax);
      layer.style.transform = `translateY(${(progress * speed * 24).toFixed(1)}px)`;
    });
  }

  function onScroll() {
    if (reduced.matches || ticking) return;
    ticking = true;
    requestAnimationFrame(update);
  }

  window.addEventListener('scroll', onScroll, { passive: true });
  reduced.addEventListener('change', () => {
    if (reduced.matches) layers.forEach((l) => (l.style.transform = ''));
    else update();
  });
</script>
