---
import { getEntry } from 'astro:content';
import VisualSlot from './VisualSlot.astro';
import ModelSlot from './ModelSlot';
import SectionHead from './SectionHead.astro';

const entry = await getEntry('profile', 'profile');
if (!entry) throw new Error('Profile content entry "profile" is missing');
const items = entry.data.currentLearning;
---

<section id="learning" aria-labelledby="learning-heading" class="mx-auto max-w-[90rem] px-4 py-24 md:px-8 md:py-36">
  <SectionHead number="03" kanji="学" label="Studying now" id="learning-heading" title="Current Learning" />
  {
    items.map((item, i) => (
      <article data-learning={item.id} class="learning grid items-center gap-10 border-t border-rule py-14 md:grid-cols-12 md:py-20">
        <div class:list={['relative md:col-span-5', i % 2 === 0 ? 'md:order-2 md:col-start-8' : 'md:order-1']}>
          <p class="label opacity-75">{String(i + 1).padStart(2, '0')} / {String(items.length).padStart(2, '0')}</p>
          <div class="mt-4 flex flex-col items-start gap-6 md:flex-row">
            {item.decoration && (
              <p aria-hidden="true" lang="ja" class="tategaki learning__kanji text-torii">
                {item.decoration}
              </p>
            )}
            <div>
              <h3 class="display text-[clamp(2.25rem,4.5vw,4rem)]">{item.title}</h3>
              <p class="learning__status mt-5 max-w-[34ch]">{item.status}</p>
            </div>
          </div>
        </div>
        <div class:list={['md:col-span-6', i % 2 === 0 ? 'md:order-1' : 'md:order-2 md:col-start-7']}>
          {item.visual === 'temple' ? (
            <ModelSlot client:visible id="temple" aspect="4 / 3" alt="Cel-shaded 3D temple model, a three-storey Japanese pagoda" />
          ) : (
            <VisualSlot label="Spring Boot logo" />
          )}
        </div>
      </article>
    ))
  }
</section>

<style>
  .learning__kanji {
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    letter-spacing: 0.06em;
  }
  .learning__status {
    font-family: var(--font-jp);
    font-size: 1.15rem;
    line-height: 1.7;
  }
</style>
