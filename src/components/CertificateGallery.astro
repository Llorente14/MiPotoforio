---
import type { CollectionEntry } from 'astro:content';
import CertSlip from './CertSlip.astro';

interface Props {
  certificates: CollectionEntry<'certificates'>[];
}

const { certificates } = Astro.props;
const fmt = new Intl.DateTimeFormat('en', { month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<ul class="mt-12 grid gap-6 md:grid-cols-2">
  {
    certificates.map((c, i) => (
      <li>
        <button
          type="button"
          data-cert-open
          data-title={c.data.title}
          data-issuer={c.data.issuer}
          data-date={fmt.format(c.data.date)}
          data-image={c.data.image}
          data-alt={c.data.imageAlt}
          data-verify={c.data.verifyUrl ?? ''}
          class="block w-full"
        >
          <CertSlip cert={c} index={i} />
        </button>
      </li>
    ))
  }
</ul>

<dialog
  id="cert-dialog"
  aria-labelledby="cert-dialog-title"
  class="cert-dialog m-auto max-h-[90vh] w-[min(92vw,52rem)] overflow-auto bg-paper p-6 text-ink backdrop:bg-[#0b0f1c]/80 md:p-9"
>
  <!-- Capped so the whole slip fits the viewport: a scrolling dialog slides content under its inset frame. -->
  <img id="cert-dialog-image" src="" alt="" class="mx-auto block max-h-[calc(90vh-16rem)] w-auto max-w-full border border-ink object-contain" />
  <h2 id="cert-dialog-title" class="display mt-6 text-[clamp(1.75rem,3.2vw,2.5rem)]"></h2>
  <p id="cert-dialog-meta" class="label mt-3 opacity-75"></p>
  <div class="mt-6 flex flex-wrap items-center gap-6">
    <a id="cert-dialog-verify" hidden class="label label-link" target="_blank" rel="noopener noreferrer">Verify</a>
    <button type="button" id="cert-dialog-close" class="label bg-ink px-4 py-2.5 text-paper">Close</button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('#cert-dialog')!;
  const q = <T extends HTMLElement>(id: string) => dialog.querySelector<T>(`#${id}`)!;
  const image = q<HTMLImageElement>('cert-dialog-image');
  const title = q('cert-dialog-title');
  const meta = q('cert-dialog-meta');
  const verify = q<HTMLAnchorElement>('cert-dialog-verify');
  let trigger: HTMLElement | null = null;

  document.querySelectorAll<HTMLButtonElement>('[data-cert-open]').forEach((btn) =>
    btn.addEventListener('click', () => {
      trigger = btn;
      image.src = btn.dataset.image ?? '';
      image.alt = btn.dataset.alt ?? '';
      title.textContent = btn.dataset.title ?? '';
      meta.textContent = `${btn.dataset.issuer} · ${btn.dataset.date}`;
      const url = btn.dataset.verify;
      verify.hidden = !url;
      if (url) verify.href = url;
      dialog.showModal();
    }),
  );

  q('cert-dialog-close').addEventListener('click', () => dialog.close());
  // Backdrop click: the dialog element itself is the event target.
  dialog.addEventListener('click', (e) => {
    if (e.target === dialog) dialog.close();
  });
  // showModal() traps focus and Escape closes; restore focus explicitly for all browsers.
  dialog.addEventListener('close', () => trigger?.focus());
</script>

<style>
  .cert-dialog {
    box-shadow: inset 0 0 0 2px var(--color-ink), inset 0 0 0 8px var(--color-paper), inset 0 0 0 9px var(--color-ink);
  }
</style>
