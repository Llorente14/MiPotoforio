---
import { getEntry } from 'astro:content';
import ModelSlot from './ModelSlot';
import StripedDisc from './StripedDisc.astro';
import SocialIcon from './SocialIcon.astro';
import cardArt from '../assets/card/front.svg?raw';

const entry = await getEntry('profile', 'profile');
if (!entry) throw new Error('Profile content entry "profile" is missing');
const { name, tagline, coordinates, socials } = entry.data;
const [first, ...rest] = name.split(' ');
const last = rest.pop() ?? '';
const middle = rest.join(' ');

// Ink grass along the bottom edge: deterministic blades so every build draws the same meadow.
const blades = Array.from({ length: 140 }, (_, i) => {
  const x = (i / 140) * 1200 + ((i * 37) % 11) - 5;
  const h = 26 + ((i * 53) % 34) + (i % 9 === 0 ? 22 : 0);
  const lean = ((i * 29) % 13) - 6;
  return `M${(x - 4).toFixed(1)} 120 Q${(x + lean * 0.4).toFixed(1)} ${120 - h * 0.6} ${(x + lean).toFixed(1)} ${120 - h} Q${(x + lean * 0.2 + 2).toFixed(1)} ${120 - h * 0.5} ${(x + 5).toFixed(1)} 120Z`;
}).join('');
---

<!-- data-sky="night" re-scopes the tokens so the Hero stays Night under every Sky Theme. -->
<section id="hero" data-sky="night" aria-labelledby="hero-heading" class="hero relative h-svh min-h-[36rem] overflow-hidden text-ink">
  <!-- Night sky of the Hero. The Card Transition fades it out to reveal the visitor's Sky Theme. -->
  <div data-hero-sky aria-hidden="true" class="hero__sky absolute inset-0 bg-paper">
    <StripedDisc class="hero__moon" bands={11} />
    <p class="tategaki hero__epithet">月下の奇術師</p>
  </div>

  <div class="relative mx-auto grid h-full max-w-[90rem] grid-cols-12 items-start gap-x-6 px-4 pt-[4.5rem] pb-[14svh] md:items-center md:px-8 md:pt-[11svh] md:pb-[12svh]">
    <div data-hero-content class="relative z-10 col-span-12 md:col-span-7 lg:col-span-6">
      <p class="label flex items-center gap-3 opacity-80">
        <span>File 01</span><span aria-hidden="true" class="h-px w-10 bg-current opacity-50"></span><span>Calling card</span>
        <span class="font-jp text-xs tracking-normal" lang="ja" aria-hidden="true">怪盗キッド</span>
      </p>
      <h1 id="hero-heading" class="display hero__name mt-[2svh]">
        <span class="block">{first}</span>
        {' '}
        <span class="block text-torii">{middle}</span>
        {' '}
        <span class="block">{last}</span>
      </h1>
      <p class="hero__tagline mt-[2.5svh] max-w-[30ch]">{tagline}</p>
      <div class="mt-[3svh] flex flex-wrap items-center gap-x-8 gap-y-4">
        <ul class="flex gap-2" aria-label="Find Axel online">
          <li><a class="hero__icon" href={socials.github} aria-label="Axel on GitHub"><SocialIcon name="github" class="size-[1.15rem]" /></a></li>
          <li><a class="hero__icon" href={socials.linkedin} aria-label="Axel on LinkedIn"><SocialIcon name="linkedin" class="size-[1.15rem]" /></a></li>
          <li><a class="hero__icon" href={`mailto:${socials.email}`} aria-label="Write to Axel"><SocialIcon name="email" class="size-[1.15rem]" /></a></li>
        </ul>
        <dl class="label flex flex-wrap gap-x-8 gap-y-2 opacity-80">
          <div><dt class="sr-only">Campus</dt><dd>UNTAR · Jakarta</dd></div>
          <div class="hidden md:block"><dt class="sr-only">Coordinates</dt><dd>{coordinates}</dd></div>
        </dl>
      </div>
      <p class="label hero__cue mt-[4svh] hidden md:flex items-center gap-3" aria-hidden="true">
        <span>Scroll</span><span class="hero__cue-line"></span><span class="font-jp text-xs tracking-normal">カードを引く</span>
      </p>
    </div>
    <div data-hero-kaito class="hero__kaito col-span-12 md:col-span-5 lg:col-span-6">
      <ModelSlot client:visible priority id="kaito" aspect="4 / 5" alt="Cel-shaded 3D Kaito Kid in his white suit and top hat, holding up a calling card" />
    </div>
  </div>

  <svg data-hero-grass aria-hidden="true" class="hero__grass" viewBox="0 0 1200 120" preserveAspectRatio="none">
    <path d={blades} />
    <rect y="112" width="1200" height="8" />
  </svg>

  <!-- The thrown card (desktop only). Decorative; the transition script grows it from Kaito's hand into a page. -->
  <div data-hero-card aria-hidden="true" class="hero-card">
    <div class="hero-card__page"></div>
    <div data-hero-card-art class="hero-card__art" set:html={cardArt} />
  </div>
</section>

<style>
  .hero__sky {
    background-image: linear-gradient(to bottom, var(--sky-top), var(--sky-bottom));
  }
  .hero :global(.hero__moon) {
    position: absolute;
    top: 15%;
    right: 9%;
    width: min(38vw, 32rem);
    color: var(--sky-body);
    opacity: 0.92;
  }
  .hero__epithet {
    position: absolute;
    top: 18%;
    right: 2.2%;
    font-size: clamp(1rem, 1.6vw, 1.5rem);
    letter-spacing: 0.4em;
    opacity: 0.55;
  }
  .hero__name {
    /* bounded by height too, so a short window never pushes the text into the grass */
    font-size: clamp(3.25rem, min(10.5vw, 14svh), 10rem);
  }
  .hero__tagline {
    font-family: var(--font-jp);
    font-size: clamp(1.05rem, 1.5vw, 1.3rem);
    line-height: 1.6;
  }
  .hero__cue-line {
    display: inline-block;
    width: 4rem;
    height: 1px;
    background: currentColor;
    transform-origin: left;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__cue-line {
      animation: cue 2.4s cubic-bezier(0.6, 0, 0.2, 1) infinite;
    }
  }
  @keyframes cue {
    0% { transform: scaleX(0); }
    50% { transform: scaleX(1); transform-origin: left; }
    51% { transform-origin: right; }
    100% { transform: scaleX(0); transform-origin: right; }
  }
  .hero__kaito {
    position: relative;
    z-index: 30;
    align-self: end;
    justify-self: end;
    width: min(100%, calc((100svh - 4rem) * 0.8));
    top: 12svh;
  }
  .hero__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .hero__icon:hover {
    background: var(--color-ink);
    color: var(--color-paper);
  }
  @media (max-width: 767px) {
    .hero__kaito {
      position: absolute;
      top: auto;
      right: -14%;
      bottom: -6vh;
      width: 88%;
    }
    .hero :global(.hero__moon) {
      top: auto;
      bottom: 12vh;
      right: -8%;
      width: 60vw;
    }
    .hero__epithet {
      display: none;
    }
  }
  .hero__grass {
    position: absolute;
    inset: auto 0 -1px;
    z-index: 40;
    width: 100%;
    height: min(15svh, 9rem);
    fill: #080b14;
    pointer-events: none;
  }

  /* Card: a CSS-built washi page (sharp at any size) under the SVG art, which fades as the card grows. */
  .hero-card {
    position: absolute;
    z-index: 25;
    left: 0;
    top: 0;
    width: 7rem;
    height: 9.8rem;
    opacity: 0;
    pointer-events: none;
    border-radius: 0.55rem;
    background: #fbfaf6;
    color: #17140f;
    box-shadow: 0 1.5rem 3rem -1rem rgb(0 0 0 / 0.45);
    will-change: transform, width, height;
  }
  .hero-card__page {
    position: absolute;
    inset: clamp(0.35rem, 1.2%, 1.25rem);
    border: 1px solid #d9d5cb;
    border-radius: inherit;
  }
  .hero-card__art {
    position: absolute;
    inset: 0;
  }
  .hero-card__art :global(svg) {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';
  import { cardProgress } from '../lib/card-progress';
  import { getDeviceCapability } from '../lib/device-capability';

  const { allow3d, reducedMotion } = getDeviceCapability();
  const hero = document.querySelector<HTMLElement>('#hero');
  const sky = hero?.querySelector<HTMLElement>('[data-hero-sky]');
  const content = hero?.querySelector<HTMLElement>('[data-hero-content]');
  const kaito = hero?.querySelector<HTMLElement>('[data-hero-kaito]');
  const grass = hero?.querySelector<HTMLElement>('[data-hero-grass]');
  const card = hero?.querySelector<HTMLElement>('[data-hero-card]');
  const art = hero?.querySelector<HTMLElement>('[data-hero-card-art]');

  // Reduced motion: no smooth scrolling, no pinning, no transition. About is reached by normal scroll.
  if (hero && sky && content && kaito && grass && card && art && !reducedMotion) {
    gsap.registerPlugin(ScrollTrigger);

    const lenis = new Lenis();
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((time) => lenis.raf(time * 1000));
    gsap.ticker.lagSmoothing(0);

    // Where Kaito's fingers hold the card, in Hero coordinates (the figure's hand sits ~25% in, 38% down).
    const hand = () => {
      const h = hero.getBoundingClientRect();
      const k = kaito.getBoundingClientRect();
      const w = Math.max(k.width * 0.13, 64);
      return { left: k.left - h.left + k.width * 0.25 - w / 2, top: k.top - h.top + k.height * 0.38 - w * 0.7, width: w, height: w * 1.4 };
    };
    const vw = () => hero.clientWidth;
    const vh = () => hero.clientHeight;

    if (allow3d) {
      // Desktop, pinned. The sketch, in four beats: the card leaves his fingers, drifts under the text,
      // spreads into a wide landscape page, then covers the screen and hands over to the page below.
      const tl = gsap.timeline({
        defaults: { ease: 'power2.inOut' },
        scrollTrigger: {
          trigger: hero,
          start: 'top top',
          end: '+=160%',
          pin: true,
          scrub: 0.6,
          invalidateOnRefresh: true,
          onUpdate: (self) => (cardProgress.value = self.progress),
        },
      });
      tl.set(card, { left: () => hand().left, top: () => hand().top, width: () => hand().width, height: () => hand().height, rotation: -14 }, 0)
        .to(card, { opacity: 1, duration: 0.04, ease: 'none' }, 0.02)
        // 1. out of his hand, toward the text
        .to(card, { left: () => vw() * 0.36, top: () => vh() * 0.42, width: () => vw() * 0.16, height: () => vw() * 0.224, rotation: 8, duration: 0.22 }, 0.04)
        // 2. a wide landscape page along the bottom; the art gives way to the bare washi page
        .to(card, { left: () => vw() * 0.06, top: () => vh() * 0.52, width: () => vw() * 0.88, height: () => vh() * 0.62, rotation: -2, borderRadius: 14, duration: 0.3 }, 0.26)
        .to(art, { opacity: 0, duration: 0.07, ease: 'none' }, 0.27)
        .to(content, { opacity: 0, y: -40, duration: 0.2 }, 0.3)
        .to(grass, { opacity: 0, duration: 0.15 }, 0.36)
        // 3. it rises and covers the screen; Kaito stays above it
        .to(card, { left: 0, top: 0, width: () => vw(), height: () => vh(), rotation: 0, borderRadius: 0, duration: 0.24 }, 0.56)
        .to(sky, { opacity: 0, duration: 0.1, ease: 'none' }, 0.8)
        // 4. Kaito bows out, the page settles into the About section
        .to(kaito, { opacity: 0, y: -60, duration: 0.14 }, 0.8)
        .to(card, { opacity: 0, duration: 0.08, ease: 'none' }, 0.92);
    } else {
      // Phones and tablets: no pinning, no 3D and no card (it could never cover an unpinned screen).
      // Only the night sky fades into the visitor's Sky Theme as the Hero scrolls away.
      gsap.to(sky, {
        opacity: 0,
        ease: 'none',
        scrollTrigger: { trigger: hero, start: '30% top', end: 'bottom top', scrub: true, invalidateOnRefresh: true },
      });
    }
  }
</script>
