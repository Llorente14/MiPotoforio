---
// Fixed-aspect placeholder for a future 3D model (ModelSlot). Keeps layout stable when the model arrives.
interface Props {
  label: string;
  kind?: 'temple' | 'leaf' | 'scene';
}

const { label, kind = 'scene' } = Astro.props;
---

<div
  role="img"
  aria-label={label}
  data-slot={kind}
  class="relative flex aspect-[4/3] w-full items-center justify-center overflow-hidden rounded-2xl bg-gradient-to-br from-sakura/50 via-paper/60 to-torii/30 shadow"
>
  {
    kind === 'leaf' && (
      <svg viewBox="0 0 64 64" class="size-1/3 text-torii" fill="currentColor" aria-hidden="true">
        <path d="M54 8C26 8 10 22 10 42c0 4 1 8 3 11 2-14 12-24 26-30-10 8-16 17-19 30 3 2 6 3 9 3 20 0 32-18 25-48z" />
      </svg>
    )
  }
  {
    kind === 'temple' && (
      <svg viewBox="0 0 64 64" class="size-1/3 text-torii" fill="currentColor" aria-hidden="true">
        <path d="M4 14c10 4 18 5 28 5s18-1 28-5v6c-3 2-6 3-9 4v4H13v-4c-3-1-6-2-9-4zM16 32h6v24h-6zM42 32h6v24h-6zM12 38h40v5H12z" />
      </svg>
    )
  }
  <slot />
</div>
