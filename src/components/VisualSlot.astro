---
// Printed illustration for a Current Learning item that has no 3D model (the Spring leaf).
// Same footprint as a ModelSlot so the zigzag stays aligned.
interface Props {
  label: string;
  kind?: 'leaf';
}

const { label } = Astro.props;
---

<div role="img" aria-label={label} data-slot="leaf" class="relative flex aspect-[4/3] w-full items-center justify-center">
  <svg viewBox="0 0 320 240" class="h-full" aria-hidden="true">
    <!-- the leaf: moss fill, ink outline and veins, a lighter cut where the light catches it -->
    <g transform="translate(160 122) rotate(-18)">
      <path d="M-96 64 C-110 -10 -40 -96 92 -98 C104 4 34 92 -96 64 Z" fill="var(--color-moss)" stroke="var(--color-ink)" stroke-width="4" stroke-linejoin="round" />
      <path d="M-70 40 C-62 -18 -10 -64 70 -76 C40 -40 -10 4 -70 40 Z" fill="color-mix(in srgb, var(--color-moss) 65%, var(--color-paper))" />
      <path d="M-104 76 C-40 20 20 -30 92 -98" fill="none" stroke="var(--color-ink)" stroke-width="4" stroke-linecap="round" />
      <path d="M-46 30 L-30 -14 M-12 4 L6 -42 M22 -24 L44 -64 M-40 38 L4 40 M-6 12 L42 8 M28 -18 L70 -26" fill="none" stroke="var(--color-ink)" stroke-width="2.5" stroke-linecap="round" />
    </g>
    <!-- a printer's registration mark -->
    <g stroke="var(--color-ink)" stroke-width="1.5" fill="none" opacity="0.6">
      <circle cx="286" cy="34" r="9" /><path d="M272 34 H300 M286 20 V48" />
    </g>
  </svg>
</div>
