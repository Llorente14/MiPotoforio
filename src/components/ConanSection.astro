---
import { getEntry } from 'astro:content';
import SectionHead from './SectionHead.astro';
import StripedDisc from './StripedDisc.astro';
import { discMaskUrl } from '../lib/striped-disc';

const entry = await getEntry('profile', 'profile');
if (!entry) throw new Error('Profile content entry "profile" is missing');
const { funFact, episode, label, title, total } = entry.data.currentlyWatching;
const mask = discMaskUrl(12);
---

<section id="conan" aria-labelledby="conan-heading" class="relative overflow-hidden border-y border-rule py-24 md:py-32">
  <div class="mx-auto grid max-w-[90rem] items-center gap-10 px-4 md:grid-cols-12 md:px-8">
    <div class="relative md:col-span-7">
      <p class="conan__wait font-jp" aria-hidden="true" lang="ja">待って</p>
      <!-- Akai in the striped sun: the clip is cut to the disc, with a shu disc printed a little off-register behind it. -->
      <div class="conan__disc">
        <StripedDisc class="conan__sun" bands={12} />
        <video
          class="conan__video"
          style={`--disc-mask: ${mask}`}
          data-conan-video
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          poster="/video/akai-poster.webp"
          aria-label="Akai Shuichi turning toward the viewer, a looping clip from Detective Conan"
        >
          <source src="/video/akai.webm" type="video/webm" />
          <source src="/video/akai.mp4" type="video/mp4" />
        </video>
      </div>
    </div>

    <div class="md:col-span-5">
      <SectionHead number="06" kanji="探" label="Off the clock" id="conan-heading" title="Fun fact" />
      <p class="conan__fact mt-8">{funFact}</p>
      <p class="conan__episode display mt-8" aria-hidden="true">
        <span class="label block font-semibold opacity-80">Episode</span>{episode}
      </p>
      <p class="mt-6 text-lg" data-watching>Currently watching: Episode {episode} ({label})</p>
      {title && <p class="mt-1 opacity-80">{title}</p>}
      {
        total && (
          <div class="mt-6">
            <progress value={episode} max={total} aria-label="Episodes watched" class="w-full accent-torii" />
            <p class="label mt-2 opacity-80">{episode} of {total} episodes</p>
          </div>
        )
      }
      <p class="label mt-10 max-w-sm leading-relaxed normal-case tracking-normal opacity-80">
        Detective Conan characters © Gosho Aoyama / TMS; fan-made art.
      </p>
    </div>
  </div>
</section>

<style>
  .conan__disc {
    position: relative;
    width: min(82%, 34rem);
    aspect-ratio: 1;
    margin-inline: auto;
  }
  .conan__disc :global(.conan__sun) {
    position: absolute;
    inset: 0;
    translate: 3% 2.5%;
    color: var(--color-torii);
  }
  .conan__video {
    position: relative;
    width: 100%;
    height: 100%;
    object-fit: cover;
    -webkit-mask: var(--disc-mask) center / contain no-repeat;
    mask: var(--disc-mask) center / contain no-repeat;
  }
  .conan__wait {
    position: absolute;
    top: 0;
    left: 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 1;
    opacity: 0.85;
  }
  /* Phones: 待って sits above the disc instead of over its edge. */
  @media (max-width: 767px) {
    .conan__wait {
      position: static;
      margin-bottom: 0.75rem;
    }
  }
  .conan__fact {
    font-family: var(--font-jp);
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    line-height: 1.3;
  }
  .conan__episode {
    font-size: clamp(6rem, 16vw, 13rem);
    font-stretch: 62%;
    line-height: 0.8;
  }
</style>

<script>
  // Reduced motion: hold the first frame instead of looping.
  const video = document.querySelector<HTMLVideoElement>('[data-conan-video]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  function sync() {
    if (!video) return;
    if (reduced.matches) {
      video.pause();
      video.currentTime = 0;
    } else {
      void video.play().catch(() => {});
    }
  }
  reduced.addEventListener('change', sync);
  sync();
</script>
