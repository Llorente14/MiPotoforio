---
import { getEntry } from 'astro:content';
import VisualSlot from './VisualSlot.astro';

const entry = await getEntry('profile', 'profile');
if (!entry) throw new Error('Profile content entry "profile" is missing');
const { episode, label, title, total } = entry.data.currentlyWatching;
---

<section id="conan" aria-labelledby="conan-heading" class="mx-auto max-w-5xl px-4 py-16">
  <h2 id="conan-heading" class="font-display text-3xl">Detective Conan</h2>
  <div class="mt-8 grid items-center gap-8 md:grid-cols-2">
    <VisualSlot kind="scene" label="Placeholder for a future 3D Akai sniping scene" />
    <div>
      <p class="text-xl" data-watching>
        Currently watching: Episode {episode} ({label})
      </p>
      {title && <p class="mt-1">{title}</p>}
      {
        total && (
          <div class="mt-4">
            <progress value={episode} max={total} aria-label="Episodes watched" class="w-full accent-torii" />
            <p class="text-sm">{episode} of {total} episodes</p>
          </div>
        )
      }
      <p class="mt-6 text-sm opacity-80">
        Detective Conan characters © Gosho Aoyama / TMS; fan-made low-poly art.
      </p>
    </div>
  </div>
</section>
