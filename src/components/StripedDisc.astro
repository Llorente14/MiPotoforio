---
// The site's signature motif: a solid disc whose lower half breaks into horizontal bands,
// like a woodblock sun printed through a slatted screen. Colour follows `currentColor`.
import { discBands } from '../lib/striped-disc';

interface Props {
  class?: string;
  // Number of bands in the lower half.
  bands?: number;
}

const { class: className, bands = 10 } = Astro.props;
const id = `disc-${Math.random().toString(36).slice(2, 8)}`;

const rects = discBands(bands);
---

<svg viewBox="0 0 200 200" class={className} aria-hidden="true" fill="currentColor">
  <clipPath id={id}><circle cx="100" cy="100" r="100" /></clipPath>
  <g clip-path={`url(#${id})`}>
    {rects.map((r) => <rect x="0" y={r.y} width="200" height={r.h} />)}
  </g>
</svg>
