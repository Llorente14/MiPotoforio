---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);
  return projects.map((project, index) => ({ params: { slug: project.id }, props: { project, index } }));
}

const { project, index } = Astro.props;
const { title, summary, stack, repoUrl, liveUrl, cover, coverAlt, screenshots, date } = project.data;
const { Content } = await render(project);
const rank = String(index + 1).padStart(2, '0');
const shots = screenshots.length > 0 ? screenshots : [{ src: cover, alt: coverAlt }];
---

<BaseLayout title={`${title} | Axel Chrisdy Sanjaya`} description={summary}>
  <article class="mx-auto max-w-[90rem] px-4 pb-24 pt-28 md:px-8 md:pt-36">
    <a class="label label-link" href="/projects/">← Back to projects</a>
    <!-- Desktop: text on the left, the gallery pinned on the right while the text scrolls. Below lg: one column. -->
    <div class="mt-12 grid gap-10 lg:grid-cols-12 lg:gap-x-12">
      <header class="min-w-0 lg:col-span-5 lg:col-start-1 lg:row-start-1">
        <p class="label flex items-center gap-3 opacity-75">
          <span>Project {rank}</span><span aria-hidden="true" class="h-px w-10 bg-current opacity-50"></span><span>{date.getUTCFullYear()}</span>
        </p>
        <h1 class="display project-title mt-4">{title}</h1>
        <p class="mt-6 max-w-md font-jp text-lg">{summary}</p>
        <dl class="mt-10 border-t border-rule">
          <div class="flex items-baseline gap-6 border-b border-rule py-3">
            <dt class="label w-20 shrink-0 opacity-75">Stack</dt>
            <dd>
              <ul class="label flex flex-wrap gap-x-4 gap-y-1" aria-label="Tech stack">
                {stack.map((s) => <li>{s}</li>)}
              </ul>
            </dd>
          </div>
        </dl>
        <p class="mt-8 flex flex-wrap gap-6">
          <a class="label label-link" href={repoUrl}>GitHub repository</a>
          {liveUrl && <a class="label label-link" href={liveUrl}>Live site</a>}
        </p>
      </header>
      <div class="min-w-0 lg:sticky lg:top-28 lg:col-span-7 lg:col-start-6 lg:row-span-2 lg:row-start-1 lg:self-start">
        <ProjectGallery title={title} shots={shots} />
      </div>
      <div class="min-w-0 lg:col-span-5 lg:col-start-1 lg:row-start-2">
        <div class="prose-print space-y-4 text-lg"><Content /></div>
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .project-title {
    font-size: clamp(2.75rem, 5vw, 5.5rem);
    overflow-wrap: anywhere;
  }
</style>
