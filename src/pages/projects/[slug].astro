---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects')).sort((a, b) => a.data.featuredOrder - b.data.featuredOrder);
  return projects.map((project, index) => ({ params: { slug: project.id }, props: { project, index } }));
}

const { project, index } = Astro.props;
const { title, summary, stack, repoUrl, liveUrl, cover, coverAlt, screenshots, date } = project.data;
const { Content } = await render(project);
const rank = String(index + 1).padStart(2, '0');
---

<BaseLayout title={`${title} | Axel Chrisdy Sanjaya`} description={summary}>
  <article class="mx-auto max-w-[90rem] px-4 pb-24 pt-28 md:px-8 md:pt-36">
    <a class="label label-link" href="/projects/">← Back to projects</a>
    <div class="mt-12 grid gap-10 md:grid-cols-12">
      <header class="md:col-span-5">
        <p class="label flex items-center gap-3 opacity-75">
          <span>Project {rank}</span><span aria-hidden="true" class="h-px w-10 bg-current opacity-50"></span><span>{date.getUTCFullYear()}</span>
        </p>
        <h1 class="display mt-4 text-[clamp(3.5rem,8vw,7.5rem)]">{title}</h1>
        <p class="mt-6 max-w-md font-jp text-lg">{summary}</p>
        <dl class="mt-10 border-t border-rule">
          <div class="flex items-baseline gap-6 border-b border-rule py-3">
            <dt class="label w-20 opacity-75">Stack</dt>
            <dd>
              <ul class="label flex flex-wrap gap-x-4 gap-y-1" aria-label="Tech stack">
                {stack.map((s) => <li>{s}</li>)}
              </ul>
            </dd>
          </div>
        </dl>
        <p class="mt-8 flex flex-wrap gap-6">
          <a class="label label-link" href={repoUrl}>GitHub repository</a>
          {liveUrl && <a class="label label-link" href={liveUrl}>Live site</a>}
        </p>
      </header>
      <div class="md:col-span-7">
        <img src={cover} alt={coverAlt} width="1200" height="630" class="w-full border-2 border-ink" />
        <div class="prose-print mt-10 space-y-4 text-lg"><Content /></div>
        {
          screenshots.length > 0 && (
            <div class="mt-10 grid gap-6">
              {screenshots.map((shot) => <img src={shot.src} alt={shot.alt} loading="lazy" class="w-full border border-ink" />)}
            </div>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>
